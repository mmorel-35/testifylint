package failnowconstrainedinterface

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

type assertOnlyTestingT interface {
	Errorf(format string, args ...interface{})
}

type requireOnlyTestingT interface {
	Errorf(format string, args ...interface{})
	FailNow()
}

func TestFailNowConstrainedInterface(t *testing.T) {
	var (
		assertT  assertOnlyTestingT
		requireT requireOnlyTestingT
	)

	// Invalid (full *testing.T supports replacements).
	{
		t.Error("failure")        // want "fail-now: use t\\.Error or t\\.Errorf instead"
		t.Fatal("failure")        // want "fail-now: use t\\.Fatal or t\\.Fatalf instead"
		t.Errorf("fmt %s", "arg") // want "fail-now: use t\\.Error or t\\.Errorf instead"
		t.Fatalf("fmt %s", "arg") // want "fail-now: use t\\.Fatal or t\\.Fatalf instead"
	}

	// Valid (ignored): constrained interfaces can miss Error/Fatal methods.
	{
		assert.Fail(assertT, "failure")
		assert.Failf(assertT, "failure", "fmt %s", "arg")
		assert.FailNow(assertT, "failure")
		assert.FailNowf(assertT, "failure", "fmt %s", "arg")

		require.Fail(requireT, "failure")
		require.Failf(requireT, "failure", "fmt %s", "arg")
		require.FailNow(requireT, "failure")
		require.FailNowf(requireT, "failure", "fmt %s", "arg")
	}
}
